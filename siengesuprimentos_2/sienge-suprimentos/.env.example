# Credenciais da API do Sienge — preencha com os dados da sua conta.
# Renomeie este arquivo para ".env" (sem o .example) depois de preencher.

# Subdominio da sua empresa (o que aparece na URL: SUAEMPRESA.sienge.com.br)
SIENGE_SUBDOMAIN=macedofortes

# Usuario e senha da API (gerados na area de Integracoes/APIs do Sienge)
SIENGE_USER=usuario-da-api
SIENGE_PASSWORD=senha-da-api

# Um token que VOCE inventa, para o site se autenticar no backend.
# Pode ser qualquer texto secreto. Cole o mesmo valor na aba Conexao do site.
APP_TOKEN=troque-por-um-texto-secreto

# Porta local (opcional)
PORT=3001
